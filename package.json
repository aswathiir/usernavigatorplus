{
  "name": "usernavigatorplus",
  "displayName": "User Navigator Plus",
  "description": "Context-aware assistant for VS Code with shortcut suggestions and workspace guidance",
  "version": "2.3.1",
  "publisher": "aswathiir",
  "license":"MIT",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:userNavigatorPlus.showShortcuts",
    "onCommand:userNavigatorPlus.showFloatingTab"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "userNavigatorPlus.showShortcuts",
        "title": "Show Contextual Shortcuts",
        "category": "User Navigator Plus"
      },
      {
        "command": "userNavigatorPlus.showFloatingTab",
        "title": "Show Guidance Panel",
        "category": "User Navigator Plus"
      }
    ],
    "configuration": {
      "title": "User Navigator Plus",
      "properties": {
        "userNavigatorPlus.enableFloatingTabs": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic floating guidance tabs"
        },
        "userNavigatorPlus.shortcutSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Show contextual shortcut suggestions"
        },
        "userNavigatorPlus.notificationDelay": {
          "type": "number",
          "default": 3000,
          "description": "Delay before showing notifications (ms)"
        }
      }
    }
  },
  "repository": {
  "type": "git",
  "url": "https://github.com/aswathiir/usernavigatorplus.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.17.32",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vsce": "latest"
  }
}
